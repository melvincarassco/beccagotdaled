# Local Git Configuration for Becca Got Daled Wedding Platform
# Repository: https://github.com/melvincarassco/beccagotdaled.git

[remote "origin"]
	url = https://github.com/melvincarassco/beccagotdaled.git
	fetch = +refs/heads/*:refs/remotes/origin/*

[branch "main"]
	remote = origin
	merge = refs/heads/main
