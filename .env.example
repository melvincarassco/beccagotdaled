# ==============================================================================
# BECCA GOT DALED (#beccagotdaled) - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Storage Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Google Drive API v3 (Service Account Integration)
# ------------------------------------------------------------------------------
# Service account client email (e.g. wedding-sync@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Service account private key (keep line breaks or base64 encoded)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The Google Drive Wedding Photo Folder ID (from folder URL)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ------------------------------------------------------------------------------
# 3. Security, Guest Auth & Admin Configuration
# ------------------------------------------------------------------------------
# Secret for signing guest session cookies
GUEST_SESSION_SECRET=your-random-32-byte-hex-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional guest PIN validation toggle (true / false)
REQUIRE_GUEST_PIN=false
